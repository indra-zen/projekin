NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: absolute site URL for auth email links and the Snap "finish" redirect (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=

# --- Payments (Midtrans Snap Sandbox only). Server-only values must never be NEXT_PUBLIC_. ---
# Must be "false": production Midtrans is not supported in the MVP.
MIDTRANS_IS_PRODUCTION=false
# Server only. Midtrans dashboard (Sandbox) → Settings → Access Keys → Server Key.
MIDTRANS_SERVER_KEY=
# Public. Same page → Client Key (loads Snap.js; without it checkout uses the Snap redirect page).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Server only. Supabase → Project Settings → API Keys: secret key (sb_secret_…) or the legacy service_role key.
# Bypasses RLS; used only by src/server/payments and src/app/api.
SUPABASE_SECRET_KEY=
# Server only. Random string; Vercel Cron sends it as a Bearer token to /api/cron/*.
CRON_SECRET=
